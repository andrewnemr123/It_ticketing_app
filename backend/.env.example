# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL database
# - Standalone MySQL install:  DB_PORT=3306, DB_USER=root, your root password
# - MAMP (started via the MAMP app):  DB_HOST=127.0.0.1 DB_PORT=8889 DB_USER=root DB_PASSWORD=root
# - Docker (docker-compose.yml):  DB_PORT=3307 DB_USER=it_ticketing DB_PASSWORD=it_ticketing
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=it_ticketing

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
